# Google Gemini API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng chính (Mặc định gemini-3-flash-preview hoặc gemini-3.8-flash)
GEMINI_MODEL=gemini-3-flash-preview

# Model siêu nhẹ/rẻ dùng cho Cổng kiểm duyệt Semantic Guardrail (Mặc định gemini-1.5-flash-8b hoặc gemini-2.0-flash-lite)
GEMINI_GUARD_MODEL=gemini-1.5-flash-8b

# Cờ mô phỏng lỗi (chỉ dùng ở môi trường DEV khi chạy test):
# Giá trị: rate_limit | timeout | bad_key | bad_json
# AI_SIMULATE_ERROR=

