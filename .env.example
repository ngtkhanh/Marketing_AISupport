# Google Gemini API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng chính (Khuyên dùng gemini-3.5-flash-lite: tốc độ cao, ổn định, quota Free Tier thoải mái)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model siêu nhẹ/rẻ dùng cho Cổng kiểm duyệt Semantic Guardrail (Mặc định gemini-3.5-flash-lite)
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite

# Cờ mô phỏng lỗi (chỉ dùng ở môi trường DEV khi chạy test):
# Giá trị: rate_limit | timeout | bad_key | bad_json
# AI_SIMULATE_ERROR=

